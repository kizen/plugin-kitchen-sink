      "hint_field_name": "ticker",
      "hint_related_object_field_name": null,
      "script_alias": "ticker"
    }
  ],
  "outputs": [
    {
      "name": "target",
      "label": "Ticker Price",
      "data_type": "number",
      "required": true,
      "input_source": "object_field",
